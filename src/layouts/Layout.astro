---
import "../styles/global.css";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";

interface Props {
  title?: string;
  description?: string;
  pageTitle?: string;
  includeHeader?: boolean;
  includeFooter?: boolean;
  headerVariant?: "default" | "minimal";
}

const {
  title,
  description = "A digital garden by Joe Maddalone — ideas, notes, visuals, and writing. Not a resume, not a course — teaching lives at el337.com.",
  pageTitle,
  includeHeader = true,
  includeFooter = true,
  headerVariant = "default",
} = Astro.props;

const siteTitle = title ?? pageTitle ?? "Joe Maddalone — A Digital Garden";
const canonical = Astro.url.href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/x-icon" href="/assets/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-icon-180x180.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16x16.png" />
    <meta name="theme-color" content="#EBE2CB" />
    <title>{siteTitle}</title>

    <!-- Inter + JetBrains Mono — grotesk + mono system per DESIGN.md -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page-shell">
      {includeHeader && <SiteHeader variant={headerVariant} />}
      <slot />
      {includeFooter && <SiteFooter />}
    </div>
  </body>
</html>

<style>
  /* Ensure grain texture from global.css sits behind */
  :global(html) {
    background: var(--bg);
  }
</style>
