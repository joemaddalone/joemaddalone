---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Pagination from "@/components/Pagination.astro";
import SectionLabel from "@/components/SectionLabel.astro";
import { slugifyStr } from "@/utils/slugify";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return paginate(getSortedPosts(posts), { pageSize: SITE.postPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const isFirst = page.currentPage === 1;
---

<Layout
  title={isFirst ? "Writing — Joe Maddalone" : `Writing — Page ${page.currentPage} — Joe Maddalone`}
  description="Writing from the garden — longer pieces tended alongside the notes and visuals."
>
  <main id="main-content" class="page-inner posts-page">
    <header class="posts-header">
      <div class="posts-kicker">
        <span class="meta-mono">GARDEN — WRITING</span>
        <span class="meta-mono">{page.total} PIECES · PAGE {page.currentPage} / {page.lastPage}</span>
      </div>
      <h1 class="posts-title">Writing</h1>
      <p class="posts-copy">
        Longer pieces from the garden — kept alongside the notes and visuals. For what needed more than a clipping.
      </p>
      <div class="posts-actions">
        <a href="/archive" class="arrow-link"><span>Browse the archive</span><span class="arrow" aria-hidden="true"> →</span></a>
        <span class="meta-mono posts-actions-sep" aria-hidden="true">·</span>
        <span class="meta-mono">{page.total} pieces</span>
      </div>
    </header>

    <section class="posts-section">
      <SectionLabel
        label={isFirst ? "Recent" : `Page ${page.currentPage}`}
        kicker={isFirst ? "Newest first" : "Older beds"}
        sublabel={`${page.data.length} on this page`}
      />

      <div class="table-head" aria-hidden="true">
        <span class="meta-mono">DATE</span>
        <span class="meta-mono">TYPE</span>
        <span class="meta-mono">TITLE — EXCERPT</span>
        <span class="meta-mono" style="text-align:right">→</span>
      </div>

      <div class="post-list">
        {page.data.map((post) => {
          const d = post.data.date;
          const year = String(new Date(d).getFullYear());
          const dateLabel = new Date(d).toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" }).toUpperCase();
          const type = (post.data.tags?.[0] ?? "note").toUpperCase();
          const href = `/posts/${slugifyStr(post.data.title)}`;
          return (
            <a href={href} class="post-row">
              <span class="col-date">
                <span class="date-main">{dateLabel}</span>
                <span class="date-year">{year}</span>
              </span>
              <span class="col-type">{type}</span>
              <span class="col-body">
                <span class="row-title">{post.data.title}</span>
                {post.data.excerpt && <span class="row-excerpt">{post.data.excerpt}</span>}
              </span>
              <span class="col-arrow" aria-hidden="true">→</span>
            </a>
          );
        })}
      </div>

      <Pagination page={page} />
    </section>
  </main>
</Layout>

<style>
  .posts-page {
    padding-bottom: clamp(40px, 6vw, 80px);
  }

  .posts-header {
    padding-block: clamp(28px, 5vw, 48px) 20px;
    border-bottom: 1px solid var(--line-soft);
  }

  .posts-kicker {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  .posts-kicker .meta-mono { font-size: 10px; }

  .posts-title {
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: clamp(32px, 5vw, 56px);
    letter-spacing: -0.04em;
    line-height: 0.9;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0;
  }

  .posts-copy {
    margin-top: 12px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink-muted);
    max-width: 56ch;
  }

  .posts-actions {
    margin-top: 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .posts-actions-sep { opacity: 0.4; }

  .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--ink);
  }

  .arrow-link .arrow { transition: transform var(--duration-normal) var(--ease); }
  .arrow-link:hover .arrow { transform: translateX(4px); }
  .arrow-link:hover { opacity: 1; }

  .posts-section {
    padding-top: 28px;
  }

  .table-head {
    display: grid;
    grid-template-columns: 140px 110px 1fr 24px;
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    margin-bottom: 2px;
  }

  .post-list {
    border-bottom: 1px solid var(--line-soft);
  }

  .post-row {
    display: grid;
    grid-template-columns: 140px 110px 1fr 24px;
    gap: 16px;
    align-items: baseline;
    padding-block: 18px;
    border-top: 1px solid var(--line-soft);
    transition:
      transform var(--duration-fast) var(--ease),
      opacity var(--duration-fast) var(--ease);
  }

  .post-row:first-child { border-top: none; }
  .post-row:hover { transform: translateX(2px); opacity: 1; }
  .post-row:hover .col-arrow { transform: translateX(4px); }

  .col-date {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .date-main {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .date-year {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
  }

  .col-type {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .col-body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .row-title {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .row-excerpt {
    font-size: 12px;
    line-height: 1.55;
    color: var(--ink-muted);
    max-width: 60ch;
  }

  .col-arrow {
    font-family: var(--font-mono);
    color: var(--ink-faint);
    text-align: right;
    transition: transform var(--duration-normal) var(--ease);
  }

  @media (max-width: 760px) {
    .table-head { display: none; }
    .post-row {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "meta arrow"
        "body body";
      gap: 8px 12px;
      padding-block: 16px;
    }
    .col-date, .col-type { grid-area: meta; display: inline-flex; gap: 8px; align-items: baseline; }
    .col-type::before { content: "/"; color: var(--line); }
    .date-year { display: none; }
    .col-body { grid-area: body; }
    .col-arrow { grid-area: arrow; align-self: center; }
  }
</style>
