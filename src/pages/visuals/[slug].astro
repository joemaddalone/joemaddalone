---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const visuals = await getCollection("visuals", ({ data }) => !data.draft);
  return visuals.map((visual) => {
    const slug = visual.id.replace(/\/index$/, "").replace(/\.mdx?$/, "").split("/")[0] ?? visual.id;
    return { params: { slug }, props: { visual } };
  });
}

const { visual } = Astro.props;
const { Content } = await render(visual);
const { title, date, description, image, alt, tag } = visual.data;

const dateLabel = new Date(date).toLocaleDateString("en-GB", {
  day: "2-digit",
  month: "long",
  year: "numeric",
}).toUpperCase();
const tagLabel = (tag ?? "visual").toUpperCase();
const slug = visual.id.replace(/\/index$/, "").replace(/\.mdx?$/, "").split("/")[0] ?? visual.id;
---

<Layout
  title={`${title ?? slug} — Visuals — Joe Maddalone`}
  description={description ?? title ?? "An image from the garden"}
>
  <main id="main-content" class="page-inner visual-page">
    <div class="visual-top">
      <a href="/visuals" class="back-link">
        <span aria-hidden="true">←</span><span> Visuals</span>
      </a>
      <span class="meta-mono visual-top-meta">{tagLabel} — {dateLabel} — {slug}</span>
    </div>
    <div class="hairline" aria-hidden="true"></div>

    <article class="visual-article">
      <header class="visual-header">
        <div class="visual-kicker">
          <span class="meta-mono">VISUAL — {slug.toUpperCase()}</span>
          <span class="meta-mono dot" aria-hidden="true">·</span>
          <span class="visual-tag">{tagLabel}</span>
        </div>

        {title && <h1 class="visual-title">{title}</h1>}
        {description && <p class="visual-desc">{description}</p>}

        <div class="visual-meta-row">
          <span class="meta-mono">{dateLabel}</span>
          <span class="meta-mono" aria-hidden="true">·</span>
          <span class="meta-mono">{slug}</span>
        </div>
      </header>

      <figure class="visual-figure">
        <div class="visual-frame">
          <Image src={image} alt={alt ?? title ?? slug} width={1200} height={675} class="visual-img" />
        </div>
        <figcaption class="visual-caption">
          <span class="meta-mono">FIG — {title ?? slug}</span>
          {alt && <span class="meta-mono visual-alt">— {alt}</span>}
        </figcaption>
      </figure>

      <div class="visual-body">
        <Content />
      </div>

      <div class="hairline" aria-hidden="true"></div>

      <div class="visual-foot-actions">
        <a href="/visuals" class="arrow-link"><span>Back to visuals</span><span class="arrow" aria-hidden="true"> →</span></a>
        <span class="meta-mono">TENDED IN src/data/images/{slug}/</span>
      </div>
    </article>
  </main>
</Layout>

<style>
  .visual-page { padding-bottom: clamp(40px, 6vw, 80px); }

  .hairline { height: 1px; background: var(--line-soft); }

  .visual-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-block: 14px;
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .back-link:hover { color: var(--ink); opacity: 1; }

  .visual-top-meta { font-size: 10px; letter-spacing: 0.06em; }

  .visual-article { padding-top: clamp(28px, 5vw, 48px); }

  .visual-kicker { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 14px; }
  .dot { opacity: 0.4; }

  .visual-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    border: 1px solid var(--line-soft);
    background: var(--surface);
    padding: 3px 8px;
    line-height: 1;
  }

  .visual-title {
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: clamp(28px, 4.2vw, 44px);
    line-height: 0.92;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0;
    overflow-wrap: anywhere;
  }

  .visual-desc {
    margin-top: 14px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-muted);
    max-width: 58ch;
  }

  .visual-meta-row {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
    align-items: center;
    padding-block: 12px;
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
  }

  .visual-meta-row .meta-mono { font-size: 10px; }

  .visual-figure { margin: 28px 0 8px; }

  .visual-frame {
    border: 1px solid var(--line-soft);
    background: var(--surface);
    overflow: hidden;
  }

  .visual-img { display: block; width: 100%; height: auto; }

  .visual-caption {
    margin-top: 8px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .visual-caption .meta-mono { font-size: 10px; color: var(--ink-faint); }
  .visual-alt { color: var(--ink-faint); text-transform: none; letter-spacing: 0; font-size: 10px; max-width: 62ch; }

  .visual-body {
    padding-top: 18px;
    font-size: 14px;
    line-height: 1.7;
    color: var(--ink-muted);
    max-width: 62ch;
  }

  .visual-body :global(p) { margin-block: 1em; }
  .visual-body :global(a) { text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 3px; }
  .visual-body :global(a:hover) { text-decoration-color: var(--ink); opacity: 1; }

  .visual-foot-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    padding-top: 18px;
  }

  .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--ink);
  }

  .arrow-link .arrow { transition: transform var(--duration-normal) var(--ease); }
  .arrow-link:hover .arrow { transform: translateX(4px); }
  .arrow-link:hover { opacity: 1; }
</style>
