---
export interface Props {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
}

const { tag, tagName } = Astro.props;
---

<li class="tag-item">
  <a href={`/tags/${tag}/`} transition:name={tag} class="tag-link">
    <span class="tag-hash" aria-hidden="true">#</span><span>{tagName.toUpperCase()}</span>
  </a>
</li>

<style>
  .tag-item { display: inline-block; }
  .tag-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    border: 1px solid var(--line-soft);
    background: var(--surface);
    padding: 4px 8px;
    line-height: 1;
  }
  .tag-link:hover { color: var(--ink); border-color: var(--line); opacity: 1; }
  .tag-hash { color: var(--ink-faint); }
</style>
