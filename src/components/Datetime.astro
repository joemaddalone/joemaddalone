---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import { SITE } from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

export interface Props {
  class?: string;
  size?: "sm" | "lg";
  timezone: string | undefined;
  date: string | Date;
}

const {
  date,
  class: className = "",
  timezone: postTimezone,
} = Astro.props;

const datetime = dayjs.tz(
  date instanceof Date ? dayjs(date).utc().format("YYYY-MM-DD") : date,
  postTimezone || SITE.timezone
);

const formattedDate = datetime.format("DD MMM YYYY").toUpperCase();
---

<time class:list={["meta-mono", className]} datetime={datetime.toISOString()}>{formattedDate}</time>

<style>
  .meta-mono {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
</style>
