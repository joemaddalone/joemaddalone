---

<div
  id="btt-btn-container"
  class="btt"
>
  <button
    data-button="back-to-top"
    class="btt-btn"
    type="button"
  >
    <span class="meta-mono">Back to top ↑</span>
  </button>
</div>

<script is:inline data-astro-rerun>
  (() => {
    const container = document.getElementById("btt-btn-container");
    const btn = document.querySelector("[data-button='back-to-top']");
    const root = document.documentElement;
    if (!container || !btn || !root) return;
    btn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
    let lastVisible = null;
    const onScroll = () => {
      const total = root.scrollHeight - root.clientHeight;
      const top = root.scrollTop;
      const visible = total > 0 && top / total > 0.22;
      if (visible !== lastVisible) {
        container.classList.toggle("is-visible", visible);
        lastVisible = visible;
      }
    };
    let ticking = false;
    document.addEventListener("scroll", () => {
      if (!ticking) {
        window.requestAnimationFrame(() => { onScroll(); ticking = false; });
        ticking = true;
      }
    }, { passive: true });
    onScroll();
  })();
</script>

<style>
  .btt {
    display: flex;
    justify-content: flex-end;
    padding-block: 10px;
    opacity: 0;
    transform: translateY(6px);
    pointer-events: none;
    transition:
      opacity var(--duration-normal) var(--ease),
      transform var(--duration-normal) var(--ease);
  }
  .btt.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .btt-btn {
    border: 1px solid var(--line-soft);
    background: var(--surface);
    padding: 6px 10px;
    cursor: pointer;
    color: var(--ink-muted);
  }
  .btt-btn:hover { color: var(--ink); border-color: var(--line); }
  .btt-btn .meta-mono { font-size: 10px; letter-spacing: 0.1em; }
</style>
