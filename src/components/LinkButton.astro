---
export interface Props {
  id?: string;
  href: string;
  class?: string;
  ariaLabel?: string;
  title?: string;
  disabled?: boolean;
}

const {
  id,
  href,
  class: className = "",
  ariaLabel,
  title,
  disabled = false,
} = Astro.props;
---

{
  disabled ? (
    <span
      id={id}
      class:list={["link-btn is-disabled", className]}
      title={title}
      aria-disabled={disabled}
    >
      <slot />
    </span>
  ) : (
    <a
      id={id}
      href={href}
      class:list={["link-btn", className]}
      aria-label={ariaLabel}
      title={title}
    >
      <slot />
    </a>
  )
}

<style>
  .link-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    transition:
      color var(--duration-fast) var(--ease),
      opacity var(--duration-fast) var(--ease);
  }
  .link-btn:hover { color: var(--ink); opacity: 1; }
  .link-btn.is-disabled { opacity: 0.35; pointer-events: none; }
</style>
