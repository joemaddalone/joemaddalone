---
import { slugifyStr } from "@/utils/slugify";
import type { CollectionEntry } from "astro:content";
import Datetime from "./Datetime.astro";
import { Image } from "astro:assets";

export interface Props extends CollectionEntry<"blog"> {
  variant?: "h2" | "h3";
  featured?: boolean;
}

const { data, featured = false } = Astro.props;

const { title, excerpt, date, timezone, coverImage } = data;

const hasImage = !!coverImage;
---

<li class:list={["group newspaper-border bg-white", featured && "col-span-full"]}>
  <a
    href={`/posts/${slugifyStr(title)}`}
    class:list={[
      "flex h-full flex-col",
      featured && "md:flex-row",
    ]}
  >
    {
      hasImage && (
        <div
          class:list={[
            "overflow-hidden border-black",
            featured ? "md:w-2/3 md:border-b-0 md:border-r" : "border-b",
          ]}
        >
          <Image
            src={coverImage}
            alt={title}
            width={featured ? 1200 : 800}
            height={featured ? 675 : 450}
            loading="lazy"
            decoding="async"
            class="newspaper-image h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
          />
        </div>
      )
    }
    <div class:list={["flex flex-1 flex-col p-4", featured && "md:w-1/3"]}>
      <div class="mb-2 font-mono text-xs uppercase tracking-widest text-black/60">
        {date && <Datetime {date} {timezone} />}
      </div>
      <h2
        class:list={[
          "font-bold leading-tight",
          featured ? "text-3xl sm:text-4xl" : "text-xl",
        ]}
      >
        {title}
      </h2>
      {
        excerpt && (
          <p
            class:list={[
              "mt-2 text-black/70",
              featured ? "text-base" : "text-sm",
            ]}
          >
            {excerpt}
          </p>
        )
      }
    </div>
  </a>
</li>
